<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Forced Light (not DayNight): every custom color in colors.xml (surface gray, privacy-card
      green, etc.) was designed for a light background. On a device in system dark mode,
      DayNight flipped default text colors to light-on-light against those fixed backgrounds,
      making several labels unreadable (e.g. the Privacy card body). Forcing Light keeps text
      contrast correct until a real dark palette is designed.
    -->
    <style name="Theme.OpenCorrector" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Used by ProcessTextActivity so it renders as a floating popup/dialog instead of a full-screen activity. -->
    <style name="Theme.OpenCorrector.Popup" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
